{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enable-banking-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],

  // KV namespaces - IDs omitted on purpose. The first deploy provisions them;
  // later deploys reuse the namespaces already bound to the Worker under these
  // binding names, so a deploy copy of this repo needs no IDs either.
  // Deploy to Cloudflare: name them differently to avoid collision, e.g.:
  //   enable-banking-mcp-data and enable-banking-mcp-oauth
  //
  // For local development, `wrangler dev` creates local KV storage.
  "kv_namespaces": [
    { "binding": "BANKING_KV" },
    { "binding": "OAUTH_KV" }
  ],

  // Enable observability
  "observability": {
    "enabled": true
  }

  // Secrets (set via `wrangler secret put` or Cloudflare dashboard):
  //
  // AUTH_SECRET (required)
  //   Password for web UI login and OAuth consent
  //
  // ENCRYPTION_SECRET (recommended)
  //   Encrypts the Enable Banking private key in KV; falls back to AUTH_SECRET
  //
  // Optional secrets (can also be configured via the setup wizard after deploy):
  //
  // ENABLE_BANKING_APP_ID (optional)
  //   Your Enable Banking application ID from the control panel
  //   If not set here, can be configured via the web UI setup wizard
  //
  // ENABLE_BANKING_PRIVATE_KEY (optional)
  //   Your RSA private key (PEM format) for JWT signing
  //   If not set here, can be configured via the web UI setup wizard
  //   When set via environment, takes precedence over wizard-configured credentials
}
